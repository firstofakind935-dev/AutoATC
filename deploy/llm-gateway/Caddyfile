{$LLM_PUBLIC_HOSTNAME} {
	# Only the OpenAI-compatible chat endpoint is exposed. Everything else
	# on the upstream (e.g. Ollama's own /api/* model-management routes)
	# stays unreachable from outside this machine.
	route /v1/* {
		@authorized {
			header Authorization "Bearer {$LLM_API_KEY}"
		}
		# Ollama rejects requests whose Host header isn't localhost/127.0.0.1
		# (DNS-rebinding protection) - without this, every proxied request
		# gets a 403 straight from Ollama regardless of the Bearer token,
		# since reverse_proxy otherwise forwards the original public Host
		# header through untouched.
		reverse_proxy @authorized {$LLM_UPSTREAM} {
			header_up Host {$LLM_UPSTREAM}
		}
		respond 401
	}

	respond 404
}
