# Copy to .env in this directory and fill in real values.

# The DDNS hostname pointed at this machine. Caddy requests a Let's
# Encrypt certificate for it automatically, which requires ports 80 and
# 443 to be forwarded from your router to this machine.
LLM_PUBLIC_HOSTNAME=yourname.ddns.net

# Shared secret the bot fleet must send as "Authorization: Bearer <this>".
# Generate one with: openssl rand -hex 32
LLM_API_KEY=

# host:port your actual LLM server listens on, from this machine's point
# of view. Default assumes Ollama running directly on the host (not in
# this compose file) on its default port. Change if you're running
# llama.cpp's server, vLLM, etc., or the model server in its own
# container (then use that container's service name instead).
LLM_UPSTREAM=host.docker.internal:11434
