# Copy to .env and fill in for local runs. On Railway, set these as the
# service's environment variables instead - PORT is provided automatically
# by Railway, no need to set it there.

# Port to listen on. Railway sets this automatically; only needed for
# local runs.
PORT=3000

# Shared secret the bot fleet must send as "Authorization: Bearer <this>"
# when posting logs to /api/ingest. Strongly recommended - without it,
# anyone who finds this URL can post fake bot logs. Generate one with:
# openssl rand -hex 32
INGEST_API_KEY=

# HTTP Basic Auth credentials to view the dashboard itself. Strongly
# recommended - without these, anyone who finds this URL can read live
# pilot transcripts and ATC replies.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional read-only key for an external consumer (e.g. a companion
# website) to pull live positions from GET /api/external/positions, as
# "Authorization: Bearer <this>". A separate credential from
# INGEST_API_KEY on purpose - this one should only ever grant read access,
# never the ability to post fake data through the ingest endpoints.
# Generate one with: openssl rand -hex 32
# Note: /api/dashboard/positions already serves the same data with NO auth
# at all (it's what the public /radar page itself polls) - only bother
# with this if you want something less discoverable/more revocable than
# that open URL.
EXTERNAL_API_KEY=
