# Copy to .env and fill in for local runs. On Railway, set these as the
# service's environment variables instead - PORT is provided automatically
# by Railway, no need to set it there.

# Port to listen on. Railway sets this automatically; only needed for
# local runs.
PORT=3000

# Shared secret the bot fleet must send as "Authorization: Bearer <this>"
# when posting logs to /api/ingest. Strongly recommended - without it,
# anyone who finds this URL can post fake bot logs. Generate one with:
# openssl rand -hex 32
INGEST_API_KEY=

# HTTP Basic Auth credentials to view the dashboard itself. Strongly
# recommended - without these, anyone who finds this URL can read live
# pilot transcripts and ATC replies.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
