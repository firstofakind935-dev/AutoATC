# Copy this file to .env and fill in real values. Never commit .env.

# API key for the "brain" (LLM) that writes ATC responses, when a bot's
# config sets ai.provider to "anthropic".
ANTHROPIC_API_KEY=

# API key for OpenAI. Required if any bot's config sets ai.provider to
# "openai" for the brain (and you leave OPENAI_BASE_URL blank - see below),
# and ALSO required if you leave STT/TTS pointed at OpenAI's hosted APIs
# instead of self-hosting them.
OPENAI_API_KEY=

# --- The "brain" LLM, when a bot's ai.provider is "openai" ---
# Leave OPENAI_BASE_URL blank to call OpenAI's hosted API (needs
# OPENAI_API_KEY above). To use a self-hosted/local LLM server instead
# (Ollama, llama.cpp's server, vLLM, text-generation-webui, etc.), set
# this to that server's URL - they all speak the same
# /v1/chat/completions shape OpenAI does. OPENAI_API_KEY becomes optional
# in that case (only needed if your server requires one).
OPENAI_BASE_URL=

# Reasoning models (e.g. Qwen3 on Ollama) write a <think>...</think> block
# before the actual reply unless told not to - real latency and cost for a
# live voice reply. Set to "none" to suppress it. Leave blank for OpenAI's
# real API or a non-reasoning model. Only takes effect when ai.provider is
# "openai" (covers Ollama/self-hosted too, since they share that request
# shape) - has no effect on ai.provider "anthropic".
LLM_REASONING_EFFORT=

# --- Speech-to-text (transcribing pilot radio calls) ---
# Leave STT_BASE_URL blank to use OpenAI's hosted Whisper API (needs
# OPENAI_API_KEY above). To self-host instead (e.g. deploy a Whisper
# server on Railway), set STT_BASE_URL to that server's public URL - it
# must implement the same /v1/audio/transcriptions contract OpenAI uses.
# STT_API_KEY is optional and only needed if your self-hosted server
# requires one; STT_MODEL lets you pass a model name your server expects
# instead of OpenAI's "whisper-1".
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# --- Text-to-speech (voicing ATC replies) ---
# Same pattern as STT above: leave TTS_BASE_URL blank to use OpenAI's
# hosted TTS API (needs OPENAI_API_KEY), or point it at a self-hosted
# server that implements the /v1/audio/speech contract.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

# --- Flight plans (optional - from your Lovable/Supabase app) ---
# Leave both blank to skip flight plan awareness entirely; the bot still
# works fine without it. Set both to let the bot see currently filed
# flight plans and match a pilot's spoken callsign against them.
# SUPABASE_KEY needs SELECT access on the flight plans table - either the
# service role key (bypasses RLS) or an anon key if you've set an RLS
# policy allowing read access to it.
SUPABASE_URL=
SUPABASE_KEY=
# Table name to query. src/flightplans/store.js is already matched to the
# app's real flight_plans schema (callsign, aircraft, dep_icao/arr_icao,
# route, cruise_alt, squawk, etc.) - only override this if you rename the
# table.
SUPABASE_FLIGHT_PLANS_TABLE=flight_plans

# --- flightradar365 bot API (src/flightradar365/client.js) ---
# Dedicated bot API for the same Lovable/Supabase app above - reads
# airports/flight_plans/atis and can publish ATIS or update/delete flight
# plans. Not yet wired into the bot's behavior; the client exists but
# nothing calls it automatically until that's decided.
FLIGHTRADAR365_BOT_KEY=

# --- Monitoring dashboard (optional) ---
# Leave blank to skip - every bot just logs to its own console/process as
# usual. Set MONITOR_URL to a deployed monitor/ instance (see monitor/README)
# to also stream every bot's logs to a live web dashboard - useful once
# you're running more than a couple of bots at once. MONITOR_API_KEY only
# needs to be set if the monitor instance has INGEST_API_KEY configured.
MONITOR_URL=
MONITOR_API_KEY=

# One Discord bot token per fleet member. The name of the env var here is
# whatever you put in each entry's "tokenEnv" field in config/bots.json.
# Create each bot application at https://discord.com/developers/applications.
# The "Server Members Intent" privileged intent is NOT required (the code
# looks up individual members on demand rather than bulk-fetching the
# whole member list). The bot does need the "Message Content Intent"
# (Bot page) enabled, plus voice permissions (Connect, Speak, View
# Channels) when you invite it to the target server.
BOT_TOWER_TOKEN=
BOT_GROUND_TOKEN=
