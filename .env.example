# Copy this file to .env and fill in real values. Never commit .env.

# API key for the "brain" (LLM) that writes ATC responses, when a bot's
# config sets ai.provider to "anthropic".
#
# A bot's config can also set ai.fallback (see config/bots.example.json) to
# a second provider/model - e.g. a self-hosted Ollama model via
# OPENAI_BASE_URL below - that it automatically switches to if the primary
# call fails for any reason (including this key running out of credits),
# so the bot never goes silent instead of replying.
ANTHROPIC_API_KEY=

# API key for OpenAI. Required if any bot's config sets ai.provider to
# "openai" for the brain (and you leave OPENAI_BASE_URL blank - see below),
# and ALSO required if you leave STT/TTS pointed at OpenAI's hosted APIs
# instead of self-hosting them.
OPENAI_API_KEY=

# --- The "brain" LLM, when a bot's ai.provider is "openai" ---
# Leave OPENAI_BASE_URL blank to call OpenAI's hosted API (needs
# OPENAI_API_KEY above). To use a self-hosted/local LLM server instead
# (Ollama, llama.cpp's server, vLLM, text-generation-webui, etc.), set
# this to that server's URL - they all speak the same
# /v1/chat/completions shape OpenAI does. OPENAI_API_KEY becomes optional
# in that case (only needed if your server requires one).
OPENAI_BASE_URL=

# Reasoning models (e.g. Qwen3 on Ollama) write a <think>...</think> block
# before the actual reply unless told not to - real latency and cost for a
# live voice reply. Set to "none" to suppress it. Leave blank for OpenAI's
# real API or a non-reasoning model. Only takes effect when ai.provider is
# "openai" (covers Ollama/self-hosted too, since they share that request
# shape) - has no effect on ai.provider "anthropic".
LLM_REASONING_EFFORT=

# --- Speech-to-text (transcribing pilot radio calls) ---
# Leave STT_BASE_URL blank to use OpenAI's hosted API (needs
# OPENAI_API_KEY above). Defaults to "gpt-4o-mini-transcribe" - cheaper
# than and noticeably more accurate than the older "whisper-1" on
# aviation callsigns/numbers. To self-host instead (e.g. deploy a Whisper
# server on Railway), set STT_BASE_URL to that server's public URL - it
# must implement the same /v1/audio/transcriptions contract OpenAI uses -
# and set STT_MODEL to whichever model name that server actually expects
# (it likely won't recognize "gpt-4o-mini-transcribe"). STT_API_KEY is
# optional and only needed if your self-hosted server requires one.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# --- Text-to-speech (voicing ATC replies) ---
# Same pattern as STT above: leave TTS_BASE_URL blank to use OpenAI's
# hosted API (needs OPENAI_API_KEY). Defaults to "gpt-4o-mini-tts" - more
# natural-sounding than the older "tts-1". To self-host instead, point
# TTS_BASE_URL at a server implementing the /v1/audio/speech contract and
# set TTS_MODEL to whichever model name it actually expects.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

# --- Flight plans (optional - from your Lovable app's bot API) ---
# Leave blank to skip flight plan awareness entirely; the bot still works
# fine without it. Set it to let the bot see currently filed flight plans
# and match a pilot's spoken callsign against them, via the flightradar365
# bot API (src/flightradar365/client.js) - reads airports/flight_plans/atis
# and can publish ATIS or update/delete flight plans. Only the flight plan
# read is wired into the bot's behavior so far; the write actions exist as
# callable functions but nothing triggers them automatically yet.
FLIGHTRADAR365_BOT_KEY=

# Also required for pushing AutoATC's own live positions to
# flightradar365.lovable.app's map (src/flightradar365/positionSync.js) -
# same key as above, different endpoint. Requires MONITOR_URL below to be
# set too (that's where positions are read from). Leave this at anything
# other than exactly "true" to keep that push disabled even with the bot
# key set - the x/y coordinate conversion is an unverified guess at the
# site's coordinate system until confirmed against the live map (see
# positionSync.js's comment on toTrackXY()).
FLIGHTRADAR365_TRACK_ENABLED=

# --- Monitoring dashboard (optional) ---
# Leave blank to skip - every bot just logs to its own console/process as
# usual. Set MONITOR_URL to a deployed monitor/ instance (see monitor/README)
# to also stream every bot's logs to a live web dashboard - useful once
# you're running more than a couple of bots at once. MONITOR_API_KEY only
# needs to be set if the monitor instance has INGEST_API_KEY configured.
#
# The same monitor instance also relays live aircraft positions reported by
# the screen-tracking companion app (see companion/) - set these two vars
# the same way to let Approach/Departure/Center see those positions too.
MONITOR_URL=
MONITOR_API_KEY=

# --- Manual testing (optional, TEST-ONLY - never set in production) ---
# When true, whichever single bot has this set ignores its own configured
# persona and instead role-plays whatever fleet position you address by
# callsign in each transmission (e.g. say "Rockford Ground, ..." then later
# "Rockford Tower, ..." on the SAME bot/channel and it answers as each in
# turn - see src/ai/personaMatcher.js). Lets you manually test many
# positions' behavior with only one real Discord token deployed, instead of
# needing the whole fleet running. Leave unset/false for every bot in a
# real deployment.
TEST_DYNAMIC_PERSONA=

# One Discord bot token per fleet member. The name of the env var here is
# whatever you put in each entry's "tokenEnv" field in config/bots.json.
# Create each bot application at https://discord.com/developers/applications.
# The "Server Members Intent" privileged intent is NOT required (the code
# looks up individual members on demand rather than bulk-fetching the
# whole member list). The bot does need the "Message Content Intent"
# (Bot page) enabled, plus voice permissions (Connect, Speak, View
# Channels) when you invite it to the target server.
BOT_TOWER_TOKEN=
BOT_GROUND_TOKEN=

# Bot Manager (see config/bots.example.json's "botmanager" entry, and
# src/bot/BotManagerBot.js) needs its own Discord application too, invited
# with the "Move Members" permission (in addition to the usual voice
# permissions) - it moves pilots between the fleet's channels for both
# failover and frequency tuning, and neither works without it.
BOT_MANAGER_TOKEN=

# Optional - only relevant if your fleet has a Center position. A second
# Discord application's token (separate from Center's own BOT_*_TOKEN),
# invited to the same server ahead of time. If Center goes offline and
# there's nothing else in the fleet to hand its traffic to, Bot Manager
# logs it in and runs it as a real AtcBot instance - same voice channel,
# persona, and AI config as the real Center bot - until Center's own
# heartbeat comes back. Leave blank to just get a loud log/alert instead
# when that happens.
CENTER_FALLBACK_TOKEN=

# Full-scale fleet: one token per position from data/frequencies.json
# (config/bots.json has a matching entry for each, tokenEnv names below).
# Leave any of these blank to keep that position offline for now -
# loadFleetConfig() skips an entry whose token isn't set rather than
# erroring, so the fleet boots fine with only some filled in. IMPORTANT:
# once you DO set one of these, that entry's "voiceChannelId" in
# config/bots.json must also be a real channel ID (not null) - unlike a
# missing token, a missing voiceChannelId on an entry whose token IS set
# is a hard validation error that fails the whole fleet's startup, not
# just that one bot.
BOT_IRCC_TOKEN=
BOT_IRFD_APP_TOKEN=
BOT_IRFD_DEP_TOKEN=
BOT_IRFD_TWR_TOKEN=
BOT_IRFD_GND_TOKEN=
BOT_IRFD_DEL_TOKEN=
BOT_IMLR_APP_TOKEN=
BOT_IMLR_TWR_TOKEN=
BOT_IMLR_GND_TOKEN=
BOT_IMLR_DEL_TOKEN=
BOT_IGAR_TWR_TOKEN=
BOT_IBLT_TWR_TOKEN=
BOT_IRTC_TOKEN=
BOT_IOCC_TOKEN=
BOT_ITKO_APP_TOKEN=
BOT_ITKO_DEP_TOKEN=
BOT_ITKO_TWR_TOKEN=
BOT_ITKO_GND_TOKEN=
BOT_ITKO_DEL_TOKEN=
BOT_IDCS_TWR_TOKEN=
BOT_IBRD_TWR_TOKEN=
BOT_IPCC_TOKEN=
BOT_IPPH_APP_TOKEN=
BOT_IPPH_TWR_TOKEN=
BOT_IPPH_GND_TOKEN=
BOT_IPPH_DEL_TOKEN=
BOT_ILKL_TWR_TOKEN=
BOT_IGCC_TOKEN=
BOT_IKFL_APP_TOKEN=
BOT_IKFL_TWR_TOKEN=
BOT_IKFL_GND_TOKEN=
BOT_IKFL_DEL_TOKEN=
BOT_ITEY_TWR_TOKEN=
BOT_ICCC_TOKEN=
BOT_ILAR_APP_TOKEN=
BOT_ILAR_TWR_TOKEN=
BOT_ILAR_GND_TOKEN=
BOT_IIAB_TWR_TOKEN=
BOT_IPAP_TWR_TOKEN=
BOT_IBAR_TWR_TOKEN=
BOT_IHEN_TWR_TOKEN=
BOT_IZCC_TOKEN=
BOT_IZOL_TWR_TOKEN=
BOT_IZOL_GND_TOKEN=
BOT_IZOL_DEL_TOKEN=
BOT_IJAF_TWR_TOKEN=
BOT_ISCM_TWR_TOKEN=
BOT_EGCC_TOKEN=
BOT_ISAU_TWR_TOKEN=
BOT_ISAU_GND_TOKEN=
BOT_ISAU_APRON_TOKEN=
BOT_IBTH_TWR_TOKEN=
BOT_ISCC_TOKEN=
BOT_ISKP_TWR_TOKEN=
BOT_USS_TWR_TOKEN=
