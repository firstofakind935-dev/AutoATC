# Copy this file to .env and fill in real values. Never commit .env.

# API key for the "brain" (LLM) that writes ATC responses, when a bot's
# config sets ai.provider to "anthropic".
ANTHROPIC_API_KEY=

# API key for OpenAI. Required if any bot's config sets ai.provider to
# "openai" for the brain, and ALSO required regardless of ai.provider
# because speech-to-text (Whisper) and text-to-speech both call OpenAI.
OPENAI_API_KEY=

# One Discord bot token per fleet member. The name of the env var here is
# whatever you put in each entry's "tokenEnv" field in config/bots.json.
# Create each bot application at https://discord.com/developers/applications,
# enable the "Server Members" is not required, but the bot needs the
# "Guilds" and "Guild Voice States" privileged/standard intents and voice
# permissions (Connect, Speak) in the target channel.
BOT_TOWER_TOKEN=
BOT_GROUND_TOKEN=
